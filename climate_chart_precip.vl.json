{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 250,
  "title": "Annual Mega-Fire Area vs. Precipitation",
  "layer": [
    {
      "data": {"url": "fires_deduplicated_summary.csv"},
      "transform": [{"filter": "datum.Year >= 1990 && datum.Year <= 2020"}],
      "mark": {"type": "bar", "color": "#c0392b"},
      "encoding": {
        "x": {"field": "Year", "type": "ordinal", "title": "Year"},
        "y": {
          "field": "AreaMillionHectares",
          "type": "quantitative",
          "title": "Mega-Fire Area (million ha)"
        },
        "tooltip": [
          {"field": "Year", "type": "ordinal"},
          {
            "field": "AreaMillionHectares",
            "title": "Area Burned (M ha)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "data": {"url": "climate_summary.csv"},
      "transform": [
        {"filter": "datum.Year >= 1990 && datum.Year <= 2020"},
        {
          "calculate": "(datum.Year == 1994 || datum.Year == 2002 || datum.Year == 2012 || datum.Year == 2019) ? 'highlight' : 'normal'",
          "as": "highlight_flag"
        }
      ],
      "encoding": {
        "x": {"field": "Year", "type": "ordinal", "title": "Year"},
        "y": {
          "field": "Precipitation",
          "type": "quantitative",
          "title": "Precipitation (mm)",
          "axis": {"orient": "right", "grid": false}
        },
        "tooltip": [
          {"field": "Year", "type": "ordinal"},
          {
            "field": "Precipitation",
            "title": "Precipitation (mm)",
            "format": ".0f"
          }
        ]
      },
      "layer": [
        {
          "mark": {"type": "line", "color": "#3498db", "strokeWidth": 2}
        },
        {
          "mark": {"type": "point", "filled": true, "stroke": "black"},
          "encoding": {
            "color": {
              "condition": {"test": "datum.highlight_flag == 'highlight'", "value": "#c0392b"},
              "value": "#555555"
            },
            "size": {
              "condition": {"test": "datum.highlight_flag == 'highlight'", "value": 150},
              "value": 25
            },
            "strokeWidth": {
              "condition": {"test": "datum.highlight_flag == 'highlight'", "value": 1.5},
              "value": 0.5
            },
            "opacity": {
              "condition": {"test": "datum.highlight_flag == 'highlight'", "value": 1}
            }
          }
        }
      ]
    }
  ],
  "resolve": {"scale": {"y": "independent"}}
}