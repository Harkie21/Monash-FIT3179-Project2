{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Australian Bushfire History and Climate Drivers",
    "fontSize": 20,
    "subtitle": [
      "An interactive dashboard exploring the relationship between climate trends and major bushfire events (>10,000 ha) in Australia."
    ],
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "config": { "view": { "stroke": null } },
  "vconcat": [
    {
      "width": "container",
      "height": 600,
      "title": "Geographic Distribution of Major Bushfires",
      "projection": {
        "scale": 800,
        "rotate": [-134, 0, 0],
        "center": [-78, -9.5]
      },
      "layer": [
        {"data": {"sphere": true}, "mark": {"type": "geoshape", "fill": "#e9f5ff"}},
        {"data": {"graticule": true}, "mark": {"type": "geoshape", "stroke": "#d4e6f1", "strokeWidth": 0.5}},
        {
          "data": {"url": "https://cdn.jsdelivr.net/npm/vega-datasets@v1.29.0/data/world-110m.json", "format": {"type": "topojson", "feature": "countries"}},
          "mark": {"type": "geoshape", "fill": "#f0ede5", "stroke": "#d4d4d4"}
        },
        {
          "data": {
            "url": "fires_final.json",
            "format": {"type": "topojson", "feature": "fires_filtered_10000ha_bushfires"}
          },
          "params": [
            {"name": "fire_hover", "select": {"type": "point", "on": "pointerover"}}
          ],
          "transform": [
            {"calculate": "toString(year(datum.properties.ignition_date))", "as": "Year"},
            {"filter": {"param": "year_brush"}}
          ],
          "mark": {"type": "geoshape", "fill": "#d62728", "opacity": "0.6"},
          "encoding": {
            "stroke": {"condition": {"param": "fire_hover", "value": "navy"}, "value": null},
            "strokeWidth": {"condition": {"param": "fire_hover", "value": 2}, "value": 0},
            "tooltip": [
              {"field": "properties.fire_name", "type": "nominal", "title": "Fire Name"},
              {"field": "properties.state", "type": "nominal", "title": "State"},
              {"field": "Year", "type": "ordinal", "title": "Year"},
              {"field": "properties.area_ha", "type": "quantitative", "title": "Area (ha)", "format": ",.0f"}
            ]
          }
        },
        {
          "data": {
            "values": [
              {"city": "Sydney", "lat": -33.88, "lon": 151.21},
              {"city": "Melbourne", "lat": -37.81, "lon": 144.96},
              {"city": "Brisbane", "lat": -27.47, "lon": 153.02},
              {"city": "Perth", "lat": -31.95, "lon": 115.86},
              {"city": "Adelaide", "lat": -34.93, "lon": 138.60},
              {"city": "Canberra", "lat": -35.28, "lon": 149.13},
              {"city": "Hobart", "lat": -42.88, "lon": 147.33},
              {"city": "Darwin", "lat": -12.46, "lon": 130.84}
            ]
          },
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"}
          },
          "layer": [
            {"mark": {"type": "circle", "color": "black", "size": 15}},
            {"mark": {"type": "text", "align": "left", "dx": 5, "dy": -5, "fontSize": 10, "fontStyle": "italic"}, "encoding": {"text": {"field": "city", "type": "nominal"}}}
          ]
        }
      ]
    },
    {
      "hconcat": [
        {
          "width": "container",
          "height": 250,
          "title": "Annual Fire Area and Climate Trends",
          "data": {"url": "climate_summary.csv"},
          "transform": [{"filter": {"param": "year_brush"}}],
          "layer": [
            {
              "data": {"url": "fires_deduplicated_summary.csv"},
              "transform": [{"filter": {"param": "year_brush"}}],
              "mark": {"type": "bar", "color": "#d62728"},
              "encoding": {
                "x": {"field": "Year", "type": "ordinal", "title": null, "axis": null},
                "y": {"field": "AreaMillionHectares", "type": "quantitative", "title": "Mega-Fire Area (million ha)"},
                "tooltip": [
                  {"field": "Year", "type": "ordinal"},
                  {"field": "AreaMillionHectares", "title": "Mega-Fire Area (M ha)", "format": ".2f"}
                ]
              }
            },
            {
              "mark": {"type": "line", "color": "#ff7f0e", "strokeWidth": 2, "point": true},
              "encoding": {
                "x": {"field": "Year", "type": "ordinal"},
                "y": {
                  "field": "MaxTemp", "type": "quantitative", "title": "Max Temperature (°C)",
                  "axis": {"orient": "right", "grid": false, "titleColor": "#ff7f0e"}
                }
              }
            },
            {
              "mark": {"type": "line", "color": "#1f77b4", "strokeWidth": 2, "point": true},
              "encoding": {
                "x": {"field": "Year", "type": "ordinal"},
                "y": {
                  "field": "Precipitation", "type": "quantitative", "title": "Precipitation (mm)",
                  "axis": {"orient": "right", "grid": false, "titleColor": "#1f77b4", "offset": 50}
                }
              }
            },
            {
              "transform": [{"filter": "datum.Year == 2019"}],
              "mark": {
                "type": "text", "align": "left", "baseline": "middle", "dx": 3, "dy": -10,
                "fontSize": 11, "fontStyle": "italic"
              },
              "encoding": {
                "x": {"field": "Year", "type": "ordinal"},
                "y": {"field": "TotalFireArea", "type": "quantitative"},
                "text": {"value": "'Black Summer' Season"}
              }
            }
          ],
          "resolve": {"scale": {"y": "independent"}}
        },
        {
          "width": "container",
          "height": 250,
          "title": "Total Mega-Fire Area by State",
          "data": {
            "url": "fires_final.json",
            "format": {"type": "topojson", "feature": "fires_filtered_10000ha_bushfires"}
          },
          "transform": [
            {"calculate": "year(datum.properties.ignition_date)", "as": "YearNum"},
            {
              "joinaggregate": [{"op": "count", "as": "count"}],
              "groupby": ["properties.fire_name", "properties.area_ha", "YearNum"]
            },
            {"window": [{"op": "rank", "as": "rank"}], "groupby": ["properties.fire_name", "properties.area_ha", "YearNum"]},
            {"filter": "datum.rank == 1"},
            {"calculate": "toString(datum.YearNum)", "as": "Year"},
            {"filter": {"param": "year_brush"}},
            {"aggregate": [{"op": "sum", "field": "properties.area_ha", "as": "total_area"}], "groupby": ["properties.state"]}
          ],
          "mark": "bar",
          "params": [
            {"name": "state_selection", "select": {"type": "point", "fields": ["properties.state"]}}
          ],
          "encoding": {
            "y": {"field": "properties.state", "type": "nominal", "title": "State", "sort": "-x"},
            "x": {"field": "total_area", "type": "quantitative", "title": "Total Area Burned (ha)"},
            "tooltip": [
              {"field": "properties.state", "title": "State"},
              {"field": "total_area", "title": "Area Burned (ha)", "format": ",.0f"}
            ],
            "opacity": {
              "condition": {"param": "state_selection", "value": 1}, "value": 0.7
            }
          }
        }
      ]
    },
    {
      "width": "container",
      "height": 60,
      "title": "Overview and Selection",
      "data": {"url": "fires_deduplicated_summary.csv"},
      "params": [
        {"name": "year_brush", "select": {"type": "interval", "encodings": ["x"]}}
      ],
      "mark": "bar",
      "encoding": {
        "x": {"field": "Year", "type": "ordinal", "title": "Year"},
        "y": {
          "field": "AreaMillionHectares",
          "type": "quantitative",
          "title": null, "axis": {"labels": false}
        }
      }
    }
  ]
}