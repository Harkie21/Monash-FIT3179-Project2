{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "autosize": {"type": "fit-x", "contains": "padding"},
  "data": {"url": "fires_deduplicated_summary2.csv"},
  "transform": [
    {"filter": "datum.Year >= 1993 && datum.Year <= 2023"},
    {
      "lookup": "State",
      "from": {
        "data": {
          "values": [
            {"StateName": "WA (Western Australia)", "TotalAreaHa": 252987500},
            {"StateName": "QLD (Queensland)", "TotalAreaHa": 173064800},
            {"StateName": "NT (Northern Territory)", "TotalAreaHa": 134912900},
            {"StateName": "SA (South Australia)", "TotalAreaHa": 98348200},
            {"StateName": "NSW (New South Wales)", "TotalAreaHa": 80064200},
            {"StateName": "VIC (Victoria)", "TotalAreaHa": 22741600},
            {"StateName": "TAS (Tasmania)", "TotalAreaHa": 6840100},
            {"StateName": "ACT (Australian Capital Territory)", "TotalAreaHa": 235800}
          ]
        },
        "key": "StateName",
        "fields": ["TotalAreaHa"]
      }
    },
    {"calculate": "(datum.AreaHectares / datum.TotalAreaHa) * 100", "as": "PercentBurned"},
    {
      "joinaggregate": [
        {"op": "sum", "field": "PercentBurned", "as": "TotalPercentState"}
      ],
      "groupby": ["State"]
    }
  ],
  "params": [
    {
      "name": "year_highlight",
      "value": null,
      "bind": {
        "input": "select",
        "name": "Highlight Year: ",
        "options": [null, 1993, 1994, 1995, 1996, 1997, 1998, 1999, 2000, 2001, 2002, 2003, 2004, 2005, 2006, 2007, 2008, 2009, 2010, 2011, 2012, 2013, 2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023],
        "labels": ["Show All", "1993", "1994", "1995", "1996", "1997", "1998", "1999", "2000", "2001", "2002", "2003", "2004", "2005", "2006", "2007", "2008", "2009", "2010", "2011", "2012", "2013", "2014", "2015", "2016", "2017", "2018", "2019", "2020", "2021", "2022", "2023"]
      }
    }
  ],
  "layer": [
    {
      "mark": {"type": "bar", "stroke": "#D6CFCB", "strokeWidth": 0.5},
      "encoding": {
        "y": {
          "field": "State",
          "type": "nominal",
          "title": "State",
          "sort": {"field": "TotalPercentState", "order": "descending"}
        },
        "x": {
          "aggregate": "sum",
          "field": "PercentBurned",
          "type": "quantitative",
          "title": "Percentage of Total Land Area Burned (%)"
        },
        "order": {"field": "Year", "type": "ordinal"},
        "color": {
          "field": "Year",
          "type": "ordinal",
          "legend": null,
          "scale": {"range": ["#C7C7C7"]}
        },
        "tooltip": [
          {"field": "State", "type": "nominal"},
          {"field": "Year", "type": "ordinal"},
          {"aggregate": "sum", "field": "PercentBurned", "type": "quantitative", "title": "Percent Burned", "format": ".3f"}
        ]
      }
    },
    {
      "transform": [
        {"filter": "year_highlight != null && datum.Year == year_highlight"}
      ],
      "mark": {"type": "bar", "color": "#8B0000"},
      "encoding": {
        "y": {
          "field": "State",
          "type": "nominal",
          "sort": {"field": "TotalPercentState", "order": "descending"}
        },
        "x": {
          "aggregate": "sum",
          "field": "PercentBurned",
          "type": "quantitative"
        },
        "order": {"field": "Year", "type": "ordinal"}
      }
    },
    {
      "transform": [
        {"filter": "year_highlight != null && datum.Year == year_highlight"},
        {
          "aggregate": [
            {"op": "sum", "field": "PercentBurned", "as": "SelPercentBurned"},
            {"op": "sum", "field": "AreaHectares", "as": "SelAreaHectares"}
          ],
          "groupby": ["State"]
        },
        {
          "calculate": "format(datum.SelPercentBurned, '.2f') + '% (' + format(datum.SelAreaHectares, ',.0f') + ' ha)'",
          "as": "SelLabel"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 4,
        "fontSize": 11,
        "color": "#333333"
      },
      "encoding": {
        "y": {
          "field": "State",
          "type": "nominal",
          "sort": {"field": "TotalPercentState", "order": "descending"}
        },
        "x": {"field": "SelPercentBurned", "type": "quantitative"},
        "text": {"field": "SelLabel", "type": "nominal"}
      }
    }
  ]
}