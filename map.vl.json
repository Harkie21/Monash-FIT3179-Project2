{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "params": [
    {
      "name": "zoom",
      "value": 1000,
      "bind": {"input": "range", "min": 3000, "max": 10000, "step": 50, "name": "Zoom: "}
    },
    {
      "name": "city",
      "value": "Australia Overall",
      "bind": {"input": "select", "options": ["Australia Overall","Central Australia","Sydney","Melbourne","Brisbane","Perth","Adelaide","Canberra","Hobart","Darwin"], "name": "Center on: "}
    }
  ],
  "vconcat": [
    {
      "width": "container",
      "height": 550,
      "config": {"view": {"stroke": null}},
      "projection": {
        "type": "orthographic",
        "scale": {"expr": "city=='Australia Overall'?950:zoom"},
        "rotate": {
          "expr": "[city=='Australia Overall'?-135:city=='Central Australia'?-135:city=='Sydney'?-151.21:city=='Melbourne'?-144.96:city=='Brisbane'?-153.02:city=='Perth'?-115.86:city=='Adelaide'?-138.60:city=='Canberra'?-149.13:city=='Hobart'?-147.33:city=='Darwin'?-130.84:-135, city=='Australia Overall'?25:city=='Central Australia'?25:city=='Sydney'?33.88:city=='Melbourne'?37.81:city=='Brisbane'?27.47:city=='Perth'?31.95:city=='Adelaide'?34.93:city=='Canberra'?35.28:city=='Hobart'?42.88:city=='Darwin'?12.46:0, 0]"
        },
        "center": {"expr": "city=='Australia Overall'?[0,15]:[0,2.5]"}
      },
      "layer": [
        {
          "data": {"sphere": true},
          "mark": {"type": "geoshape", "fill": "#d4e6f1"}
        },
        {
          "data": {
            "url": "au-states-topo.json",
            "format": {"type": "topojson", "feature": "austates"}
          },
          "mark": {"type": "geoshape", "fill": "#F9F9F9", "stroke": "#D6CFCB"}
        },
        {
          "data": {
            "url": "fires_final.json",
            "format": {"type": "topojson", "feature": "fires_filtered_10000ha_bushfires"}
          },
          "params": [
            {
              "name": "fire_hover",
              "select": {"type": "point", "on": "pointerover"}
            }
          ],
          "transform": [
            {"calculate": "toString(year(datum.properties.ignition_date))", "as": "Year"},
            {"filter": {"param": "year_brush"}}
          ],
          "mark": {"type": "geoshape", "opacity": 0.9},
          "encoding": {
            "color": {
              "field": "properties.area_ha",
              "type": "quantitative",
              "title": "Fire Size (ha)",
              "scale": {"scheme": "orangered", "range": ["#F28C28", "#8B0000"]},
              "legend": {
                "orient": "bottom",
                "offset": -2
              }
            },
            "stroke": {
              "condition": {"selection": "fire_hover", "value": "black"},
              "value": null
            },
            "strokeWidth": {
              "condition": {"selection": "fire_hover", "value": 1},
              "value": 0
            },
            "tooltip": [
              {"field": "properties.fire_name", "type": "nominal", "title": "Location"},
              {"field": "properties.state", "type": "nominal", "title": "State"},
              {"field": "Year", "type": "ordinal", "title": "Year"},
              {"field": "properties.area_ha", "type": "quantitative", "title": "Area (ha)", "format": ",.0f"}
            ]
          }
        },
        {
          "data": {
            "values": [
              {"city": "Sydney", "lat": -33.88, "lon": 151.21},
              {"city": "Melbourne", "lat": -37.81, "lon": 144.96},
              {"city": "Brisbane", "lat": -27.47, "lon": 153.02},
              {"city": "Perth", "lat": -31.95, "lon": 115.86},
              {"city": "Adelaide", "lat": -34.93, "lon": 138.60},
              {"city": "Canberra", "lat": -35.28, "lon": 149.13},
              {"city": "Hobart", "lat": -42.88, "lon": 147.33},
              {"city": "Darwin", "lat": -12.46, "lon": 130.84}
            ]
          },
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"}
          },
          "layer": [
            {"mark": {"type": "circle", "color": "#3D405B", "size": 15}},
            {
              "mark": {
                "type": "text",
                "align": "left",
                "dx": 5,
                "dy": -5,
                "fontSize": 13,
                "fontStyle": "italic",
                "color": "#3D405B"
              },
              "encoding": {"text": {"field": "city", "type": "nominal"}}
            }
          ]
        }
      ]
    },
    {
      "width": "container",
      "height": 60,
      "data": {"url": "fires_deduplicated_summary.csv"},
      "transform": [
        {"filter": "datum.Year >= 1993 && datum.Year <= 2023"}
      ],
      "params": [
        {"name": "year_brush", "select": {"type": "interval", "encodings": ["x"]}}
      ],
      "mark": {"type": "bar", "cornerRadiusEnd": 4, "color": "#8B0000"},
      "encoding": {
        "x": {"field": "Year", "type": "ordinal", "title": "Year"},
        "y": {
          "field": "AreaMillionHectares",
          "type": "quantitative",
          "title": null,
          "axis": {"labels": false}
        }
      }
    },
    {
      "width": "container",
      "height": 24,
      "mark": {"type": "text", "align": "center", "baseline": "top", "dx": 0, "fontSize": 12, "color": "#818D9D"},
      "data": {"values": [{"note": "Tip: Select a range of years to filter fires. Drag the selection left or right to move it. Click once to clear."}]},
      "encoding": {
        "x": {"expr": "width/2"},
        "text": {"field": "note", "type": "nominal"}
      }
    }
  ]
}